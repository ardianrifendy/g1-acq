#!name=G1 Pro Annual Test
#!desc=v7.6.0 legacy compatibility entry: uses the same three-tier script as G1 ACQ, supporting Ultra 1-month free trial (20TB g1.20tb.1month_eft.acq, 30TB g1.ai.ultra.1month_eft.acq) with independent 3-month 90p fallback and 2TB 12-month promo target g1.2tb.ai.12months_ip_90p (no .acq); passively collects within /ai? with recent 10 responses, newly added, and duplicate diagnostics; main module is g1-acq-v7.sgmodule (enable only one); does not actively query full SKU catalogs
#!system=ios

[Rule]
# Same as legacy module: reject UDP 443 for traffic using this configuration.
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT-NO-DROP

[Script]
g1-pro-annual-test = type=http-response,pattern=^https:\/\/one\.google\.com\/ai\?,requires-body=1,max-size=0,script-path=https://cdn.jsdelivr.net/gh/crhywun/g1-acq@v7.6.0/g1-acq.js
g1-sku-report = type=http-request,pattern=^https:\/\/one\.google\.com\/g1-sku-report\/?(?:\?.*)?$,script-path=https://cdn.jsdelivr.net/gh/crhywun/g1-acq@v7.6.0/g1-sku-report.js

[MITM]
hostname = %APPEND% one.google.com
